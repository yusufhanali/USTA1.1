    def gaze_test_circular_movement(self, radius, period, duration, arc_angle_deg, gaze_target_tracker, camera_tracker):
        """
        Circular movement of the gaze.
        :param radius: radius of the circular movement
        :param period: period of the circular movement
        :param duration: duration of the circular movement
        :param arc_angle_deg: angle in degrees for the arc
        """
        if (self.gaze_test_circular_movement_ongoing):
            print("Gaze test circular movement is already ongoing.")
            return
        self.gaze_test_circular_movement_ongoing = True
        while not self.tfBuffer.can_transform(self.base, gaze_target_tracker, rclpy.time.Time(seconds=0)):
            print("Waiting for transform from base to gaze target...")
            time.sleep(0.1)
        
        deg_to_rad = arc_angle_deg * (np.pi / 180)
        print("Arc angle in radians: ", deg_to_rad)
        
        rot_speed = deg_to_rad / period  # radians per second
        
        ang_0 = deg_to_rad/2 + np.pi/2 + np.pi/4 # + np.pi/4 is because the robots base has a 45degree offset
        angle = lambda t: -(rot_speed * (t)) + ang_0
        
        # we will check whether gaze_target is in front of the robot as it should be, because sometimes an unknown error causes the robot to look behind (probably due to the tf tree)
        transform_correct = False
        print("Waiting to transform gaze_target correctly: ")
        while not transform_correct:
            try:
                gaze_target_tf = self.tfBuffer.lookup_transform("world", gaze_target_tracker, rclpy.time.Time(seconds=0)).transform
                base_tf = self.tfBuffer.lookup_transform("world", self.base, rclpy.time.Time(seconds=0)).transform
                if (gaze_target_tf.translation.x - base_tf.translation.x < 0.0):
                    transform_correct = True
            except Exception as e:
                time.sleep(0.1)
            
        eye_tf = self.tfBuffer.lookup_transform(self.base, gaze_target_tracker, rclpy.time.Time(seconds=0)).transform
                
        center_x = eye_tf.translation.x
        center_y = eye_tf.translation.y
        center_z = eye_tf.translation.z
                
        print("Center: ", center_x, center_y, center_z)
                
        x_position = lambda ang: radius * np.cos(ang) + center_x
        y_position = lambda ang: radius * np.sin(ang) + center_y
        z_position = lambda ang: center_z - 0.08

        x_derivative = lambda ang: radius * np.sin(ang) * rot_speed
        y_derivative = lambda ang: -radius * np.cos(ang) * rot_speed
        z_derivative = lambda ang: 0.0
        
        # VISUALIZATION
        #------------------------------------------------------------------------------------------------------------
        id = 0        
        points = np.linspace(ang_0, angle(period), 100)
        traj_points = MarkerArray()
        for pt in points:
            
            marker = Marker()
            marker.header.frame_id = self.base
            marker.header.stamp = self.get_clock().now().to_msg()
            marker.ns = "trajectory"
            marker.id = id
            marker.type = marker.SPHERE
            marker.action = marker.ADD
            marker.pose.position.x = x_position(pt)
            marker.pose.position.y = y_position(pt)
            marker.pose.position.z = z_position(pt)
            marker.pose.orientation.x = 0.0
            marker.pose.orientation.y = 0.0
            marker.pose.orientation.z = 0.0
            marker.pose.orientation.w = 1.0
            marker.scale.x = 0.01
            marker.scale.y = 0.01
            marker.scale.z = 0.01
            marker.color.r = 1.0
            marker.color.g = 1.0
            marker.color.b = 0.0
            marker.color.a = 1.0
                            
            traj_points.markers.append(marker)
            
            id += 1
        
        for pt in points:
            
            marker = Marker()
            marker.header.frame_id = self.base
            marker.header.stamp = self.get_clock().now().to_msg()
            marker.ns = "trajectory_derivatives"
            marker.id = id
            marker.type = marker.ARROW
            marker.action = marker.ADD
            marker.scale.x = 0.01  # Arrow shaft diameter
            marker.scale.y = 0.02  # Arrow head diameter
            marker.scale.z = 0.02  # Arrow head length
            marker.color.r = 0.0
            marker.color.g = 1.0
            marker.color.b = 0.0
            marker.color.a = 1.0

            # Set the arrow direction using derivatives
            arrow_vector = np.array([x_derivative(pt), y_derivative(pt), z_derivative(pt)])
            arrow_vector /= np.linalg.norm(arrow_vector)  # Normalize the vector
            marker.points = [
                Point(x=x_position(pt), y=y_position(pt), z=z_position(pt)),
                Point(
                    x=x_position(pt) + arrow_vector[0] * 0.1,
                    y=y_position(pt) + arrow_vector[1] * 0.1,
                    z=z_position(pt) + arrow_vector[2] * 0.1,
                ),
            ]

            traj_points.markers.append(marker)
            
            id += 1
        self.traj_publisher.publish(traj_points)    
        #------------------------------------------------------------------------------------------------------------
        
        #BELOW PART SERVES AS ITS OWN DOCUMENTATION FOR THE ROTATION LOGIC IN INVERSE JACOBIAN CONTROL
        #------------------------------------------------------------------------------------------------------------- 
        start_pos = np.array([x_position(ang_0), y_position(ang_0), z_position(ang_0)])
        
        target_tf = self.tfBuffer.lookup_transform(self.base, gaze_target_tracker, rclpy.time.Time(seconds=0))
        curr_target = np.array([target_tf.transform.translation.x, target_tf.transform.translation.y, target_tf.transform.translation.z - 0.08])
        print("Curr Target:", curr_target)
        
        self.publish_arrow(start_pos, curr_target)
               
        desired_z = curr_target - start_pos
        desired_z /= np.linalg.norm(desired_z)
        desired_y = np.array([0, 0, 1])
        desired_x = np.cross(desired_y, desired_z)
        desired_x /= np.linalg.norm(desired_x)
        desired_y = np.cross(desired_z, desired_x)
        desired_y /= np.linalg.norm(desired_y)
        rot_matrix = np.array([desired_x, desired_y, desired_z]).T # desired end rotation in base
        
        base_to_eef = self.tfBuffer.lookup_transform(self.eef, self.base, rclpy.time.Time(seconds=0))
        base_to_eef_matrix = R.from_quat([base_to_eef.transform.rotation.x,
                                base_to_eef.transform.rotation.y,
                                base_to_eef.transform.rotation.z,
                                base_to_eef.transform.rotation.w]).as_matrix()
        
        rot_matrix = base_to_eef_matrix @ rot_matrix
        rotvec = R.from_matrix(rot_matrix).as_rotvec()
        
        eef_to_base = self.tfBuffer.lookup_transform(self.base, self.eef, rclpy.time.Time(seconds=0))
        rotvec = R.from_quat([eef_to_base.transform.rotation.x,
                                eef_to_base.transform.rotation.y,
                                eef_to_base.transform.rotation.z,
                                eef_to_base.transform.rotation.w]).apply(rotvec)
        
        print("Rotvec: ", rotvec)
        #-------------------------------------------------------------------------------------------------------------
        
        self.go_to_pose_in_base(start_pos, desired_orientation=rotvec, speed=0.1)
        
        if gaze_config.get_play_sound_when_recording_starts():
            self.gaze_test_play_recording_started_sound()
        # we will only now publish the start recording message, because we need to be in the correct position first (which is at the start of the circular arc)
        self.publish_to_start_recording_for_gaze_test_circular_movement(start=True)

        start_time = time.time()
        
        
        while time.time() - start_time < duration:
            
            curr_time = time.time() - start_time
            reverse = (curr_time // period) % 2
            sign = -reverse * 2 + 1
            curr_angle = angle((curr_time % period)*sign + reverse*period)
            
            linear_velocity = np.array([x_derivative(curr_angle), y_derivative(curr_angle), z_derivative(curr_angle)]) * sign
            
            """curr_eef = self.get_current_coordinate()"""
            curr_cam_tf = self.tfBuffer.lookup_transform(self.base, camera_tracker, rclpy.time.Time(seconds=0)).transform.translation
            curr_cam = np.array([curr_cam_tf.x, curr_cam_tf.y, curr_cam_tf.z])
                           
            target_tf = self.tfBuffer.lookup_transform(self.base, gaze_target_tracker, rclpy.time.Time(seconds=0))
            curr_target = np.array([target_tf.transform.translation.x, target_tf.transform.translation.y, target_tf.transform.translation.z])
                            
            desired_z = curr_target - curr_cam
            desired_z /= np.linalg.norm(desired_z)
            desired_y = np.array([0, 0, 1])
            desired_x = np.cross(desired_y, desired_z)
            desired_x /= np.linalg.norm(desired_x)
            desired_y = np.cross(desired_z, desired_x)
            desired_y /= np.linalg.norm(desired_y)
            rot_matrix = np.array([desired_x, desired_y, desired_z]).T # desired end rotation in base
            
            base_to_eef = self.tfBuffer.lookup_transform(self.eef, self.base, rclpy.time.Time(seconds=0))
            base_to_eef_matrix = R.from_quat([base_to_eef.transform.rotation.x,
                                    base_to_eef.transform.rotation.y,
                                    base_to_eef.transform.rotation.z,
                                    base_to_eef.transform.rotation.w]).as_matrix()
            
            rot_matrix = base_to_eef_matrix @ rot_matrix
            rotvec = R.from_matrix(rot_matrix).as_rotvec()
            
            eef_to_base = self.tfBuffer.lookup_transform(self.base, self.eef, rclpy.time.Time(seconds=0))
            rotvec = R.from_quat([eef_to_base.transform.rotation.x,
                                    eef_to_base.transform.rotation.y,
                                    eef_to_base.transform.rotation.z,
                                    eef_to_base.transform.rotation.w]).apply(rotvec)            
            rotvec *= 2
                                          
            self.publish_arrow(curr_cam, curr_target)
            
            desired_velocity = np.concatenate((linear_velocity, rotvec))
            
            pinv_jacobian = self.get_inverse_jacobian()
            velocity_command = pinv_jacobian @ desired_velocity
            
            self.publishVelocityCommand(velocity_command)
            self.ros_rate.sleep()
            
        # we will publish to stop the recording on data_collector node.
        self.publish_to_start_recording_for_gaze_test_circular_movement(start=False)
        self.stop_movement()
        self.gaze_test_circular_movement_ongoing = False
            
    def gaze_test_circular_movement_complete(self):
        if (self.gaze_test_circular_movement_ongoing):
            print("Gaze test circular movement is already ongoing.")
            return
        print("Starting circular movement.")
        try:
            filename = gaze_config.get_joint_pos_path_for_center()
            try:
                initial_joint_pos = gaze_load_joint_pos(filename)
            except Exception:
                print(f"Error loading joint position file: {filename} : ", traceback.format_exc())
                sys.exit(1)
            try:
                self.go_to_joint_pos(initial_joint_pos, speed=0.3)
                self.stop_movement()
            except Exception as e:    
                print("Error in gaze_test_circular_movement_complete in going to joint position: ", traceback.format_exc())

            # Run circular movement
            self.gaze_test_circular_movement(
                radius = self.get_gaze_test_circular_movement_config("radius"),
                period = self.get_gaze_test_circular_movement_config("period"),
                duration = self.get_gaze_test_circular_movement_config("duration"),
                arc_angle_deg = self.get_gaze_test_circular_movement_config("arc_angle_deg"),
                gaze_target_tracker = self.get_gaze_test_circular_movement_config("gaze_target_tracker"),
                camera_tracker = self.get_gaze_test_circular_movement_config("camera_tracker")
            )
            self.stop_movement()
            # Return to initial joint position
            self.go_to_joint_pos(initial_joint_pos, speed=0.3)
            self.stop_movement()
        except Exception as e:
            print("Error in gaze_test_circular_movement_complete: ", traceback.format_exc())

        print("Finished circular movement.")

            
GAZE_JOINT_POS_DIR = gaze_config.get_joint_pos_dir()

def gaze_save_joint_pos(joint_pos, filename):
    """
    Saves the joint position as a .npy file.
    """
    os.makedirs(GAZE_JOINT_POS_DIR, exist_ok=True)
    if not filename.endswith(".npy"):
        filename += ".npy"
    path = os.path.join(GAZE_JOINT_POS_DIR, filename)
    np.save(path, joint_pos)
    print(f"Joint position saved to {path}")
    
def gaze_load_joint_pos(filename):
    """
    Loads joint position from .npy file.
    """
    if not filename.endswith(".npy"):
        filename += ".npy"
    path = os.path.join(GAZE_JOINT_POS_DIR, filename)
    if not os.path.exists(path):
        raise FileNotFoundError(f"Joint position file not found: {path}")
    return np.load(path)

