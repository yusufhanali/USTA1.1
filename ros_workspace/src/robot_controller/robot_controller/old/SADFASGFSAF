    def get_gaze_velocities(self, breathing_task):
        
        try:
            cw1 = 0
            cw2 = 0                
            
            tf = self.tfBuffer.lookup_transform(self.world, self.tf_name, rclpy.time.Time())        
            tf_matrix = np.eye(4)
            tf_matrix[0:3, 0:3] = R.from_quat([tf.transform.rotation.x,
                                                tf.transform.rotation.y,
                                                tf.transform.rotation.z,
                                                tf.transform.rotation.w]).as_matrix()
            tf_matrix[0:3, 3] = np.array([tf.transform.translation.x,
                                        tf.transform.translation.y,
                                        tf.transform.translation.z])        
            ee = self.get_current_coordinate()
            ee = self.base_to_world_homogeneous @ np.concatenate((ee, [1]))
            pos = np.array([tf.transform.translation.x - ee[0], tf.transform.translation.y - ee[1], tf.transform.translation.z - ee[2]])
            dist_to_head = np.linalg.norm(pos)
            dist_to_head = dist_to_head * 0.1 + self.prev_dist_to_head * 0.9
            self.prev_dist_to_head = dist_to_head
            self.gaze_multiplier = (2.5445)*dist_to_head + 1.8168
            self.gaze_multiplier *= self.breathe_frequency*2

            instant_velocities = breathing_task
            delta = instant_velocities[:3]
            #delta *= 0 # Comment this line to enable gazing
                    
            gazing_velocities = np.zeros(self.num_of_total_joints - self.num_of_breathing_joints)
            try:
                
                base_to_w1_rot = base_to_wrist1_rotation(self.joint_states_global["pos"])
                delta_in_w1 = base_to_w1_rot.T @ delta    
                
                base_to_head = self.world_to_base_homogeneous @ tf_matrix
                
                w1_to_base = wrist1_to_base_transformation(self.joint_states_global["pos"])            
                head_in_w1 = w1_to_base @ base_to_head
                head_in_w1_pos = np.array([head_in_w1[0, 3], head_in_w1[1, 3]-delta_in_w1[1], 0])
                
                w2_to_base = wrist2_to_base_transformation(self.joint_states_global["pos"])
                head_in_w2 = w2_to_base @ base_to_head
                head_in_w2_pos = np.array([head_in_w2[0, 3], head_in_w2[1, 3], 0])
                
                head_in_w1_norm = np.linalg.norm(head_in_w1_pos)
                cw1 = np.arccos(0.0997 / head_in_w1_norm) - np.arccos(np.dot([0,-1,0], head_in_w1_pos/head_in_w1_norm))
                cw1 = cw1*(-1) if head_in_w1_pos[0] > 0 else cw1
                cw1 = angular_wrap(cw1)
                gazing_velocities[0] = cw1*self.gaze_multiplier
                
                head_in_w2_norm = np.linalg.norm(head_in_w2_pos)
                cw2 = np.arccos(np.dot([0,1,0], head_in_w2_pos/head_in_w2_norm))
                cw2 = cw2*(-1) if head_in_w2_pos[0] > 0 else cw2
                cw2 = angular_wrap(cw2)
                gazing_velocities[1] = cw2*self.gaze_multiplier
                    
            except Exception as e:
                gazing_velocities = np.zeros(self.num_of_total_joints - self.num_of_breathing_joints)
                print("Error in getting head position: ", traceback.format_exc())
            finally:
                gazing_velocities = gazing_velocities * 0.1 + self.prev_gaze_velocities * 0.9
                self.prev_gaze_velocities = gazing_velocities
                gaze_velocities_arr.append(gazing_velocities)
                return gazing_velocities
        except Exception as e:
            print("Error in getting gaze velocities: ", traceback.format_exc())
            return np.zeros(self.num_of_total_joints - self.num_of_breathing_joints)

