    def gaze_test_horizontal_movement(self,
                                    radius: float,
                                    period: float,
                                    direction: np.ndarray,
                                    duration: float = -1.0):
        """
        Pure feed‑forward horizontal oscillation:
            center → left → center → right → center
        One full cycle lasts `period` seconds.

        Uses the same 10‑%↔100‑% easing profile, but pre‑scales the nominal
        speed so that the area under the velocity curve matches the requested
        displacement exactly (eliminates net drift).

        :param radius:   maximum displacement from centre (metres)
        :param period:   time for one full 4‑segment cycle (seconds)
        :param direction: 3‑vector axis along which to move
        :param duration: total run time (seconds), ‑1 for infinite
        """
        # ---- constants -------------------------------------------------------
        EASE_AREA = 0.775  # ∫ multiplier dt over [0,1] with your profile

        axis   = direction / np.linalg.norm(direction)
        seg_t  = period / 4.0
        segments = [
            ( 0.0,  -radius),   # centre → left
            (-radius, 0.0),     # left   → centre
            ( 0.0,   radius),   # centre → right
            ( radius, 0.0),     # right  → centre
        ]

        t_start = time.time()
        stop = False

        while not stop:
            for start_off, end_off in segments:
                dist   = end_off - start_off
                speed  = abs(dist) / (seg_t * EASE_AREA)  # *** corrected ***
                velvec = axis * np.sign(dist) * speed
                cmd6   = np.concatenate((velvec, np.zeros(3)))

                t0 = time.time()
                while time.time() - t0 < seg_t:
                    if duration > 0 and (time.time() - t_start) >= duration:
                        stop = True
                        break

                    p = (time.time() - t0) / seg_t  # 0–1

                    # easing profile
                    if p < 0.25:
                        mult = 0.1 + 0.9 * (p * 4)
                    elif p > 0.75:
                        mult = 0.1 + 0.9 * ((1 - p) * 4)
                    else:
                        mult = 1.0

                    twist = self.get_inverse_jacobian() @ (mult * cmd6)
                    self.publishVelocityCommand(twist)
                    self.ros_rate.sleep()

                self.stop_movement()
                if stop:
                    break

